# Copy to .env.local for local development. On Vercel, set these in
# Project → Settings → Environment Variables.

# Admin panel password (/admin)
ADMIN_SECRET=

# Neon Postgres — stores all site content and backups.
# Added automatically when you connect Neon via Vercel → Storage.
# Leave empty locally to store content in data/*.json instead.
DATABASE_URL=

# Cloudinary — stores uploaded images and videos.
# Cloudinary dashboard → Settings → API Keys → "API environment variable".
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# WhatsApp click-to-chat number (international format, no +)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Contact form email settings (nodemailer)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_TO=
